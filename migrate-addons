#!/bin/zsh
# Copy add-ons between two Nuvio installs using each app's own "Manage from phone" server.
#
# Only one app can be foreground at a time, so this runs in two phases:
#
#   1. On the TV: official Nuvio > Settings > Addons > "Manage from phone"
#        ./migrate-addons export 192.168.0.166 8080 ~/nuvio-addons.json
#   2. On the TV: Nuvio Glass > Settings > Addons > "Manage from phone"
#        ./migrate-addons import 192.168.0.166 8080 ~/nuvio-addons.json
#   3. Approve the pending change on the TV.
#
# Ports start at 8080 and climb to the first free one; the TV shows the address.
#
# Add-on URLs often embed debrid API keys, so nothing here prints the URLs. The export
# file DOES contain them - it is your data on your machine, but delete it when done.
set -e
MODE="$1"; IP="$2"; PORT="$3"; FILE="$4"
[[ -z "$MODE" || -z "$IP" || -z "$PORT" || -z "$FILE" ]] && {
  echo "usage: ./migrate-addons export|import <tv-ip> <port> <file>"; exit 1; }

case "$MODE" in
  export)
    echo "reading add-ons from $IP:$PORT ..."
    curl -fsS --max-time 20 "http://$IP:$PORT/api/addons" -o "$FILE"
    chmod 600 "$FILE"
    python3 - "$FILE" <<'PY'
import json, sys
addons = json.load(open(sys.argv[1]))
print(f"  saved {len(addons)}: " + ", ".join(a.get("name", "?") for a in addons))
PY
    echo "saved to $FILE (contains your keys - delete it when finished)"
    ;;
  import)
    [[ -f "$FILE" ]] || { echo "no such file: $FILE"; exit 1; }
    BODY=$(mktemp -t nuvio-body); trap 'rm -f "$BODY"' EXIT
    python3 - "$FILE" "$BODY" <<'PY'
import json, sys
addons = json.load(open(sys.argv[1]))
urls = [a["url"] for a in addons if a.get("url")]
json.dump({"urls": urls}, open(sys.argv[2], "w"))
print(f"  sending {len(urls)}: " + ", ".join(a.get("name", "?") for a in addons))
PY
    curl -fsS --max-time 20 -X POST "http://$IP:$PORT/api/addons" \
      -H "Content-Type: application/json" --data-binary "@$BODY" >/dev/null
    echo "sent. Approve the pending change on the TV."
    ;;
  *) echo "mode must be export or import"; exit 1 ;;
esac
